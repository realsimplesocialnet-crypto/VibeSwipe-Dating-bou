{
  "expo": {
    "name": "Myage",
    "slug": "vibeswipe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vibeswipe",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "beauty.myage"
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Myage to use your location when you choose a nearby Discover area or share your live location in Safety Center."
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Myage to take a live selfie for face verification.",
          "photosPermission": "Allow Myage to choose your profile photos."
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-video",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
