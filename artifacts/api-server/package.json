{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts && pnpm run test:video-calls",
    "test:video-calls": "tsx --test tests/videoCallSignaling.test.mts"
  },
  "dependencies": {
    "@clerk/backend": "^3.29.0",
    "@clerk/express": "^2.1.90",
    "@clerk/shared": "^4.45.1",
    "@google-cloud/storage": "^9.0.0",
    "@huggingface/transformers": "3.8.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "country-state-city": "3.2.1",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.4",
    "http-proxy-middleware": "^4.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "socket.io": "^4.8.4",
    "web-push": "^4.0.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/web-push": "^3.6.4",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
