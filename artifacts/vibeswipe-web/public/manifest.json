{
  "id": "/",
  "name": "MyAgeBeauty",
  "short_name": "MyAgeBeauty",
  "description": "MyAgeBeauty is an adults-only social app for Reels, posts, and conversations.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "prefer_related_applications": false,
  "related_applications": [
    { "platform": "webapp", "url": "manifest.json?v=10" }
  ],
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": ["lifestyle", "social"],
  "icons": [
    {
      "src": "myage-monochrome-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "myage-monochrome-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "myage-monochrome-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
